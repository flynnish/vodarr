# Go build artifacts
/vodarr
/cmd/vodarr/vodarr

# Config with credentials (never commit)
config.yml
/config/

# Local notes with sensitive info (never commit)
*.local.md

# Frontend build output (goes to internal/web/dist/ at build time)
web/node_modules/
web/dist/
# The folder itself is kept (by .gitkeep) so go:embed builds without a UI build.
internal/web/dist/*
!internal/web/dist/.gitkeep

# Logs
*.log

# OS
.DS_Store

# Git worktrees
.worktrees/

# Internal planning / spec drafts — kept local, not published
docs/plans/
docs/superpowers/
